# Settings for the Docker deployment (docker-compose.production.yml). Placeholders only: copy this file to .env.docker on
# the server, fill it in, and restrict it:   cp .env.docker.example .env.docker && chmod 600 .env.docker
# Never commit .env.docker, and never put a real value in this example. Every command passes it explicitly:
#   docker compose -f docker-compose.production.yml --env-file .env.docker ...
# Step by step: docs/docker-deployment.md.
#
# Passwords: make them long and random, and use letters and digits only (no $ ' " \ or spaces), so no tool in the chain
# can misread them.      openssl rand -hex 24

# ---- Required --------------------------------------------------------------------------------------------------------

# The host name people type in the browser. It must be the name on the TLS certificate and must resolve, on the college
# network, to this server.
FAMS_PUBLIC_HOST=<appraisal.your-college-domain>

# Three different passwords. FAMS_DB_PASSWORD is the account the application runs as (read and write rows only);
# FAMS_DB_MIGRATION_PASSWORD is the account that creates tables and triggers at start-up; the root password is for
# administering MySQL (backups and restores) from inside its container.
FAMS_DB_PASSWORD=<random-password-1>
FAMS_DB_MIGRATION_PASSWORD=<random-password-2>
FAMS_DB_ROOT_PASSWORD=<random-password-3>

# The folder (on another disk or machine, mounted here) the backups are written to. The backend reads latest.json from it
# to show backup status in the administrator console. It must exist before the stack starts.
FAMS_BACKUP_DIR_HOST=<absolute-path-of-the-backup-folder>

# Folder on the host holding fullchain.pem (the certificate and any intermediate certificates) and privkey.pem (its private
# key). Default: ./deploy/tls next to docker-compose.production.yml. It must exist; the files are never committed.
# FAMS_TLS_DIR=/etc/fams/tls

# ---- First start only ------------------------------------------------------------------------------------------------

# The first administrator. Used only while no administrator exists; the account must choose a new password at first
# sign-in. Remove both lines (and run `up -d` again) once you have signed in.
# FAMS_BOOTSTRAP_ADMIN_EMAIL=<admin@your-college-domain>
# FAMS_BOOTSTRAP_ADMIN_PASSWORD=<a-password-that-passes-the-policy>

# ---- Optional --------------------------------------------------------------------------------------------------------

# The old password of every account an administrator creates or resets. Unset: the college's standard one (docs/deployment.md).
# FAMS_DEFAULT_PASSWORD=

# Time zone of every container, and so of the dates on reports and in the audit trail. Decide it before the first start.
# FAMS_TIMEZONE=Asia/Kolkata

# Tag of the application images (docker build / docker save / docker load). Something that names the version.
# FAMS_IMAGE_TAG=latest

# Where the persistent data lives. By default Docker volumes (fams-prod_mysql-data and fams-prod_documents). To keep either in
# a folder instead, give its absolute path; the folder must exist and belong to the container's user (documents: uid 10001,
# MySQL: uid 999). Either way a copy on the same machine is not a backup.
# FAMS_DOCUMENTS_DATA=/srv/fams/documents
# FAMS_MYSQL_DATA=/srv/fams/mysql

# Which address of this machine the proxy listens on (ports 80 and 443). 0.0.0.0 = every IPv4 address.
# FAMS_LISTEN_ADDRESS=0.0.0.0

# What the administrator console warns about
# FAMS_BACKUP_MAX_AGE_HOURS=36
# FAMS_RESTORE_TEST_MAX_AGE_DAYS=180
# FAMS_STORAGE_WARN_PERCENT=80
