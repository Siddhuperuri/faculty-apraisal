# FAMS reverse proxy, PLAIN HTTP. TEMPORARY, FOR A CLOSED TEST ONLY (docker-compose.http-test.yml).
#
# Passwords, session cookies and appraisals cross the network unencrypted. Do not use this for real users or real
# data: anyone on the same network segment can read them. It exists to try the stack out before the college's
# certificate is ready; the production file is fams-https.conf.template.

server_tokens off;
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 2m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";
    proxy_redirect off;
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $backend http://backend:8080;
        proxy_pass $backend;
    }

    location / {
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
    }
}
