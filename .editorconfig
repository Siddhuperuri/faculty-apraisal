# What every editor should do in this repository. The build enforces the Java parts (backend/config/checkstyle.xml)
# and ESLint the TypeScript parts; this keeps files from drifting before they get that far.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 180

[*.{sql,xml}]
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.ps1]
indent_size = 4
end_of_line = crlf
